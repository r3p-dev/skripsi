@let(appUrl = config('app.appUrl'))
@let(description = 'Layanan cuci sepatu profesional di Bandung Raya dengan antar-jemput gratis. Pembersihan dan perawatan sepatu selesai dalam 2-4 hari.')

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />

    <title inertia>
      UmimaClean — Layanan Cuci Sepatu Bandung
    </title>

    <meta name="description" content="{{ description }}" />
    <link rel="canonical" href="{{ appUrl }}{{ request.url() }}" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="UmimaClean" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content="UmimaClean — Layanan Cuci Sepatu Bandung" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:url" content="{{ appUrl }}{{ request.url() }}" />
    <meta property="og:image" content="{{ appUrl }}/images/logo.jpg" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="UmimaClean — Layanan Cuci Sepatu Bandung" />
    <meta name="twitter:description" content="{{ description }}" />
    <meta name="twitter:image" content="{{ appUrl }}/images/logo.jpg" />

    <link rel="manifest" href="/site.webmanifest" />
    <meta name="application-name" content="UmimaClean" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="UmimaClean" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <link rel="icon" href="/icons/favicon-96x96.png" sizes="96x96" type="image/png" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml">
    <link rel="shortcut icon" href="/icons/favicon.ico" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />

    <script type="application/ld+json">
      {{{ JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        name: 'UmimaClean',
        description: description,
        url: appUrl,
        image: appUrl + '/images/logo.jpg',
        priceRange: 'Rp',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Bandung',
          addressRegion: 'Jawa Barat',
          addressCountry: 'ID',
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: config('app.shop').latitude,
          longitude: config('app.shop').longitude,
        },
        areaServed: ['Bandung', 'Cimahi', 'Kabupaten Bandung', 'Kabupaten Bandung Barat'],
      }) }}}
    </script>

    @viteReactRefresh()
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body class="bg-paper">
    @inertia()
  </body>

</html>
